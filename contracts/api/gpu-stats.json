    "navPerShare": "decimal or null",
    "revenue24h": "decimal USDC",
    "paidPerShare24h": "decimal USDC/share",
    "yieldPct": "decimal percent",
    "workingPct20h": "decimal percent",
    "paidToHoldersLastNight": "decimal USDC",
    "openingPrice": "decimal USDC/share",
