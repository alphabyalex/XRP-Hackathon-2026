# services/credit environment. Copy to the repo root .env (or services/credit/.env) and fill in.
# Never commit the real file: Quicknode URLs contain an auth token.

MOCK=1
PORT=7100
INTERNAL_API_KEY=

# Quicknode XRPL HTTPS endpoints (dashboard > Endpoints). Unset = public endpoint, source "public".
QUICKNODE_XRPL_MAINNET_URL=
QUICKNODE_XRPL_TESTNET_URL=
# Only if the Quicknode dashboard offers XRPL Devnet (their docs list mainnet and testnet only).
QUICKNODE_XRPL_DEVNET_URL=

# Live monitoring: streams (Quicknode Streams webhook, default), websocket, or off.
MONITOR_MODE=streams
# Network the Quicknode Stream reads: testnet, or devnet if the dashboard offers it.
STREAMS_NETWORK=testnet
# Local testing only. Never set in a deployed service.
STREAMS_ALLOW_UNSIGNED=0
# Security token of the Quicknode Stream (Stream settings > Security token).
QUICKNODE_STREAMS_TOKEN=
# Quicknode account API key, used to keep the Key-Value Store watchlist in sync.
QUICKNODE_API_KEY=
QUICKNODE_KV_LIST=moonshift-borrowers

# Other Moonshift services
API_URL=http://localhost:4000
RISK_URL=http://localhost:7000
