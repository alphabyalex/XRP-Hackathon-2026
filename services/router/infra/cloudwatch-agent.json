{
  "agent": { "metrics_collection_interval": 30, "run_as_user": "cwagent" },
  "metrics": {
    "namespace": "Moonshift/Workers",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}", "InstanceType": "${aws:InstanceType}" },
    "metrics_collected": {
      "nvidia_gpu": {
        "measurement": [
          "utilization_gpu",
          "utilization_memory",
          "memory_used",
          "memory_total",
          "temperature_gpu",
          "power_draw"
        ],
        "metrics_collection_interval": 30
      },
      "mem": { "measurement": ["mem_used_percent"] }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/moonshift/compute.log", "log_group_name": "/moonshift/router/workers", "log_stream_name": "{instance_id}", "retention_in_days": 14 }
        ]
      }
    }
  }
}
