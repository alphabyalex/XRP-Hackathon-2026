# Copy to .env and fill in. .env is gitignored. Never commit or print real values.
# Testnet and test funds only.

# --- XRPL network ---
# devnet = XLS-65/66 lending (vaults, loans). testnet = original escrow loans.
NETWORK=devnet
# Optional devnet node override. Quicknode has no devnet, so it is never used there.
DEVNET_WSS=
XRPL_WSS=wss://s.altnet.rippletest.net:51233
# Optional sponsor RPC, one-line switch, leave blank to use the public node above.
QUICKNODE_WSS=

# --- XRPL account seeds (created by Tharun's setup script, packages/xrpl) ---
TDX_ISSUER_SEED=
SHARE_ISSUER_SEED=
CONTRACT_ISSUER_SEED=
TREASURY_GPU_A_SEED=
TREASURY_GPU_B_SEED=
PROTOCOL_FEES_SEED=
LENDING_POOL_SEED=
ORACLE_SEED=
ALICE_SEED=
BOB_SEED=
CAROL_SEED=
DEV_SEED=

# Devnet accounts (written by NETWORK=devnet npm run xrpl:setup). Never commit values.
DEVNET_TDX_ISSUER_SEED=
DEVNET_SHARE_ISSUER_SEED=
DEVNET_CONTRACT_ISSUER_SEED=
DEVNET_TREASURY_GPU_A_SEED=
DEVNET_TREASURY_GPU_B_SEED=
DEVNET_PROTOCOL_FEES_SEED=
DEVNET_LENDING_POOL_SEED=
DEVNET_ORACLE_SEED=
DEVNET_ALICE_SEED=
DEVNET_BOB_SEED=
DEVNET_CAROL_SEED=
DEVNET_DEV_SEED=

# --- Service URLs (apps/api calls these) ---
# Ports 5001 and 7001 avoid macOS Monterey/Ventura/Sonoma AirPlay Receiver conflicts on 5000/7000
COMPUTE_URL=http://localhost:5001
PRICING_URL=http://localhost:6100
RISK_URL=http://localhost:7001
CREDIT_URL=http://localhost:7100
API_URL=http://localhost:4000

# --- Service-to-service auth ---
INTERNAL_API_KEY=
ADMIN_KEY=

# --- Mock switches, 1 = mock, 0 = real ---
MOCK_XRPL=1
MOCK_COMPUTE=1
MOCK_PRICING=1

# --- Demo / timing ---
SLOT_MINUTES=5
ORACLE_AUTO=0

# --- AWS / Bedrock (services/compute, services/pricing) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# --- Akash Network Decentralized GPU Compute (akt CLI / Console API) ---
AKASH_API_KEY=
AKT_CONSOLE_API_KEY=
