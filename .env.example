# Copy to .env and fill in. .env is gitignored. Never commit or print real values.
# Testnet and test funds only.

# --- XRPL network ---
XRPL_WSS=wss://s.altnet.rippletest.net:51233
# Optional sponsor RPC, one-line switch, leave blank to use the public node above.
QUICKNODE_WSS=

# --- XRPL account seeds (created by Tharun's setup script, packages/xrpl) ---
TDX_ISSUER_SEED=
SHARE_ISSUER_SEED=
CONTRACT_ISSUER_SEED=
TREASURY_GPU_A_SEED=
TREASURY_GPU_B_SEED=
PROTOCOL_FEES_SEED=
LENDING_POOL_SEED=
ORACLE_SEED=
ALICE_SEED=
BOB_SEED=
CAROL_SEED=
DEV_SEED=

# --- Service URLs (apps/api calls these) ---
COMPUTE_URL=http://localhost:5000
PRICING_URL=http://localhost:6000
API_URL=http://localhost:4000

# --- Service-to-service auth ---
INTERNAL_API_KEY=
ADMIN_KEY=

# --- Mock switches, 1 = mock, 0 = real ---
MOCK_XRPL=1
MOCK_COMPUTE=1
MOCK_PRICING=1

# --- Demo / timing ---
SLOT_MINUTES=5
ORACLE_AUTO=0

# --- AWS / Bedrock (services/compute, services/pricing) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
