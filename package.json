{
  "name": "moonshift",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w apps/web",
    "vercel-build": "npm run build -w apps/web",
    "dev": "concurrently -n web,api -c blue,green \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w apps/api && npm run typecheck -w packages/shared && npm run typecheck -w packages/xrpl",
    "test": "npm run test -w packages/xrpl && npm run test -w apps/api",
    "test:xrpl": "npm run test -w packages/xrpl",
    "test:api": "npm run test -w apps/api",
    "xrpl:features": "npm run features -w packages/xrpl",
    "xrpl:setup": "npm run setup -w packages/xrpl",
    "xrpl:smoke": "npm run smoke -w packages/xrpl",
    "demo": "node scripts/demo.mjs",
    "demo:mock": "node scripts/demo.mjs --mock-xrpl",
    "demo:prod": "node scripts/demo.mjs --prod",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:check": "node scripts/demo-path.mjs",
    "account:reset": "node scripts/account-reset.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
